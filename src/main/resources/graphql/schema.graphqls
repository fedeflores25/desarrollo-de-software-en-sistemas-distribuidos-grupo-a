"""Tipos de vehiculos disponibles para alquiler."""
enum TipoVehiculo {
    SEDAN
    SUV
    PICKUP
    COUPE
    HATCHBACK
}

"""Informacion de un vehiculo disponible."""
type VehiculoDisponible {
    patente: String!
    marca: String!
    modelo: String!
    anio: Int!
    color: String
    tipo: TipoVehiculo!
    precioDiario: Float!
}

"""Filtros para consultar disponibilidad. Las fechas son obligatorias."""
input DisponibilidadFiltro {
    tipo: TipoVehiculo
    marca: String
    modelo: String
    precioMin: Float
    precioMax: Float
    fechaInicio: String!
    fechaFin: String!
}

type HistorialResponse {
    vehiculo: String
    patente: String
    fechaInicio: String
    fechaFinalizacion: String
    cantidadDias: Int
    importeTotal: Float
    estado: String
}

# 1. El objeto de respuesta (Lo que le devolvemos al frontend)
type ConsultaReservaResponse {
    cliente: String
    vehiculo: String
    patente: String
    fechaInicio: String
    fechaFinalizacion: String
    precioDiario: Float
    importeTotal: Float
    estado: String
}

# 2. El objeto de filtros opcionales (Lo que nos envía el frontend)
input ReservaFiltro {
    clienteId: ID
    vehiculoId: ID
    tipoVehiculo: String
    estado: String
    fechaInicio: String
    fechaFin: String
}


type Query {
    """Consulta vehiculos activos y disponibles durante el periodo indicado."""
    vehiculosDisponibles(
        filtro: DisponibilidadFiltro!
    ): [VehiculoDisponible!]!

    """Historial de alquileres"""
    consultarHistorialAlquileres: [HistorialResponse]

    """Consulta de reservas realizadas"""
    consultarReservas(filtro: ReservaFiltro): [ConsultaReservaResponse]

}

